<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- filesDir/animal_photos/ : fotos de animales ya guardadas (se mantiene para que sigan cargando) -->
    <files-path
        name="animal_photos"
        path="animal_photos/" />

    <!-- filesDir/photos/ : fotos definitivas (PhotoFileManager) -->
    <files-path
        name="photos"
        path="photos/" />

    <files-path
        name="inspections"
        path="inspections/" />

    <!-- cacheDir/camera/ : fotos temporales de la cámara -->
    <cache-path
        name="camera"
        path="camera/" />

</paths>